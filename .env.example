# Copy to .env and fill in. .env is git-ignored; never commit real passwords or keys.

# Database container (docker-compose.yml)
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=wiki
MARIADB_USER=
MARIADB_PASSWORD=
DB_BIND=127.0.0.1          # on the shared machine: its Tailscale IP
INNODB_BUFFER_POOL=2G      # about half the machine's RAM
MHNSW_CACHE=1G             # vector index cache

# App and scripts: where the database is, and who you are (each person has their own login)
DB_HOST=127.0.0.1          # teammates: the shared machine's Tailscale IP
DB_PORT=3306              # host port; use another (e.g. 3307) if 3306 is taken
DB_USER=
DB_PASSWORD=
DB_NAME=wiki

# The embedding model is fixed in app/embed.py (bge-m3), not a setting: passages and questions
# must match. Its ~2.3 GB download goes to HF_HOME (set it to a disk with room).

# A (data and time): add your keys below

# B (search, answers, app): add your keys below
LLM_PROVIDER=anthropic     # or gemini, openai, ollama
LLM_MODEL=
LLM_API_KEY=
ASK_DAILY_LIMIT=400      # model answers per day before /ask says 429 (protects credits)
ASK_HOURLY_PER_VISITOR=20  # model answers per visitor (IP) per hour
